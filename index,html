<!-- ============ CART DRAWER ============ -->
<div class="overlay" id="overlay"></div>

<aside class="cart" id="cart" aria-label="Shopping cart">
  <div class="cart-head">
    <div>
      <h3>Your Order</h3>
      <small id="cartSummary">0 items</small>
    </div>
    <button class="icon-btn" id="closeCart" aria-label="Close cart">✕</button>
  </div>

  <div class="cart-items" id="cartItems"></div>

  <div class="cart-empty" id="cartEmpty">
    <div class="big">☁️</div>
    <p>Your plate is empty</p>
    <small>Add something delicious to begin</small>
  </div>

  <div class="cart-foot">
    <div class="row"><span>Subtotal</span><span id="subtotal">$0.00</span></div>
    <div class="row"><span>Delivery</span><span id="delivery">$0.00</span></div>
    <div class="row total"><span>Total</span><span id="total">$0.00</span></div>
    <button class="btn primary full" id="checkout">Place Order →</button>
  </div>
</aside>

<!-- ============ TOAST ============ -->
<div class="toast" id="toast"><span id="toastMsg">Added to cart</span></div>

<script>
/* ============================================================
   MENU DATA
   ============================================================ */
const MENU = [
  { id:'m1', name:'Golden Truffle Risotto', cat:'mains',    price:24.00, emoji:'🍚', rating:4.9, tag:"Chef's Pick", desc:'Carnaroli rice, black truffle shavings, 24-month aged parmesan.', grad:'linear-gradient(140deg,#3d2814,#7c4a18)' },
  { id:'m2', name:'Wagyu Signature Burger', cat:'mains',    price:18.50, emoji:'🍔', rating:4.8, tag:'Bestseller',  desc:'A5 wagyu patty, smoked cheddar, brioche, truffle aioli.',        grad:'linear-gradient(140deg,#40200f,#8a3d14)' },
  { id:'m3', name:'Lobster Linguine',       cat:'mains',    price:28.00, emoji:'🍝', rating:4.9, tag:'Premium',     desc:'Fresh Maine lobster, garlic butter, chili, hand-cut pasta.',      grad:'linear-gradient(140deg,#4a1520,#8f2436)' },
  { id:'s1', name:'Burrata & Heirloom',     cat:'starters', price:14.00, emoji:'🍅', rating:4.7, tag:'',            desc:'Creamy burrata, heirloom tomatoes, basil oil, sea salt.',         grad:'linear-gradient(140deg,#3a1414,#8d2a2a)' },
  { id:'s2', name:'Crispy Calamari',        cat:'starters', price:12.50, emoji:'🦑', rating:4.6, tag:'',            desc:'Lightly battered squid, lemon aioli, charred lime.',              grad:'linear-gradient(140deg,#1b2f3a,#2f6d84)' },
  { id:'s3', name:'Truffle Parmesan Fries', cat:'starters', price:9.00,  emoji:'🍟', rating:4.8, tag:'Popular',     desc:'Triple-cooked fries, truffle oil, parmesan snow, chives.',        grad:'linear-gradient(140deg,#3b3210,#8a7420)' },
  { id:'p1', name:'Margherita Regina',      cat:'pizza',    price:16.00, emoji:'🍕', rating:4.8, tag:'Classic',     desc:'San Marzano tomato, fior di latte, fresh basil, olive oil.',      grad:'linear-gradient(140deg,#4a1a12,#a83a22)' },
  { id:'p2', name:'Pepperoni Inferno',      cat:'pizza',    price:19.00, emoji:'🍕', rating:4.9, tag:'Spicy 🔥',    desc:'Double pepperoni, calabrian chili, hot honey drizzle.',           grad:'linear-gradient(140deg,#4d1010,#a01d1d)' },
  { id:'d1', name:'Molten Chocolate Sphere',cat:'desserts', price:11.00, emoji:'🍫', rating:5.0, tag:'Signature',   desc:'Valrhona dark chocolate, warm ganache, gold leaf.',               grad:'linear-gradient(140deg,#2b1a12,#5e3823)' },
  { id:'d2', name:'Vanilla Bean Cheesecake',cat:'desserts', price:10.00, emoji:'🍰', rating:4.7, tag:'',            desc:'Madagascar vanilla, buttery biscuit base, berry coulis.',         grad:'linear-gradient(140deg,#3a2a3f,#6f4d78)' },
  { id:'k1', name:'Iced Berry Sangria',     cat:'drinks',   price:8.00,  emoji:'🍹', rating:4.6, tag:'',            desc:'Mixed berries, citrus, mint, sparkling water.',                   grad:'linear-gradient(140deg,#33103a,#7a2472)' },
  { id:'k2', name:'Velvet Espresso Martini',cat:'drinks',   price:12.00, emoji:'🍸', rating:4.9, tag:'Bar Favourite',desc:'Cold brew, vanilla vodka, silky crema, cocoa dust.',             grad:'linear-gradient(140deg,#241a12,#4d3726)' }
];

/* ============================================================
   STATE
   ============================================================ */
const cart = new Map();          // id -> quantity
const DELIVERY_FEE = 3.99;
const FREE_DELIVERY_OVER = 50;

const $ = (id) => document.getElementById(id);
const money = (n) => `$${n.toFixed(2)}`;

/* ============================================================
   RENDER MENU
   ============================================================ */
function renderMenu(cat = 'all'){
  const grid = $('menuGrid');
  const list = cat === 'all' ? MENU : MENU.filter(d => d.cat === cat);

  grid.innerHTML = list.map((d, i) => `
    <article class="card" style="animation-delay:${i * 55}ms">
      <div class="card-media" style="background:${d.grad}">
        ${d.tag ? `<span class="tag">${d.tag}</span>` : ''}
        <span class="card-emoji">${d.emoji}</span>
      </div>
      <div class="card-body">
        <div class="card-top">
          <h3>${d.name}</h3>
          <span class="rating">★ ${d.rating}</span>
        </div>
        <p>${d.desc}</p>
        <div class="card-bottom">
          <span class="price">${money(d.price)}</span>
          <button class="add" data-add="${d.id}" aria-label="Add ${d.name} to cart">+</button>
        </div>
      </div>
    </article>
  `).join('');
}

/* ============================================================
   CART LOGIC
   ============================================================ */
function addToCart(id){
  cart.set(id, (cart.get(id) || 0) + 1);
  renderCart();

  const item = MENU.find(m => m.id === id);
  showToast(`${item.emoji}  ${item.name} added`);

  const badge = $('cartCount');
  badge.classList.remove('pop');
  void badge.offsetWidth;         // restart animation
  badge.classList.add('pop');
}

function changeQty(id, delta){
  const qty = (cart.get(id) || 0) + delta;
  if (qty <= 0) cart.delete(id);
  else cart.set(id, qty);
  renderCart();
}

function removeItem(id){
  cart.delete(id);
  renderCart();
}

function renderCart(){
  const entries = [...cart.entries()];
  const count = entries.reduce((sum, [, q]) => sum + q, 0);

  $('cartCount').textContent = count;
  $('cartSummary').textContent = `${count} item${count === 1 ? '' : 's'}`;

  const itemsEl = $('cartItems');
  const emptyEl = $('cartEmpty');

  if (!entries.length){
    itemsEl.style.display = 'none';
    emptyEl.style.display = 'grid';
  } else {
    itemsEl.style.display = 'flex';
    emptyEl.style.display = 'none';

    itemsEl.innerHTML = entries.map(([id, qty]) => {
      const d = MENU.find(m => m.id === id);
      return `
        <div class="c-item">
          <div class="c-thumb">${d.emoji}</div>
          <div class="c-info">
            <h4>${d.name}</h4>
            <span>${money(d.price * qty)}</span>
            <div class="qty">
              <button data-minus="${id}" aria-label="Decrease quantity">−</button>
              <b>${qty}</b>
              <button data-plus="${id}" aria-label="Increase quantity">+</button>
            </div>
          </div>
          <button class="c-remove" data-remove="${id}" aria-label="Remove ${d.name}">✕</button>
        </div>
      `;
    }).join('');
  }

  /* Totals */
  const subtotal = entries.reduce((sum, [id, q]) => {
    const d = MENU.find(m => m.id === id);
    return sum + d.price * q;
  }, 0);

  const delivery = subtotal === 0 ? 0
                 : subtotal >= FREE_DELIVERY_OVER ? 0
                 : DELIVERY_FEE;

  $('subtotal').textContent = money(subtotal);
  $('delivery').textContent = delivery === 0 && subtotal > 0
    ? 'FREE 🎉'
    : money(delivery);
  $('total').textContent = money(subtotal + delivery);

  $('checkout').disabled = subtotal === 0;
  $('checkout').style.opacity = subtotal === 0 ? .45 : 1;
  $('checkout').style.cursor = subtotal === 0 ? 'not-allowed' : 'pointer';
}

/* ============================================================
   DRAWER + TOAST
   ============================================================ */
function openCart(){
  $('cart').classList.add('open');
  $('overlay').classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeCart(){
  $('cart').classList.remove('open');
  $('overlay').classList.remove('show');
  document.body.style.overflow = '';
}

let toastTimer;
function showToast(msg){
  const t = $('toast');
  $('toastMsg').textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

/* ============================================================
   EVENTS
   ============================================================ */
// Category filters
$('filters').addEventListener('click', (e) => {
  const pill = e.target.closest('.pill');
  if (!pill) return;
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  pill.classList.add('active');
  renderMenu(pill.dataset.cat);
});

// Add to cart (delegated)
$('menuGrid').addEventListener('click', (e) => {
  const btn = e.target.closest('[data-add]');
  if (!btn) return;
  addToCart(btn.dataset.add);
});

// Cart item controls (delegated)
$('cartItems').addEventListener('click', (e) => {
  const plus   = e.target.closest('[data-plus]');
  const minus  = e.target.closest('[data-minus]');
  const remove = e.target.closest('[data-remove]');

  if (plus)   changeQty(plus.dataset.plus, 1);
  if (minus)  changeQty(minus.dataset.minus, -1);
  if (remove) removeItem(remove.dataset.remove);
});

$('cartBtn').addEventListener('click', openCart);
$('closeCart').addEventListener('click', closeCart);
$('overlay').addEventListener('click', closeCart);

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeCart();
});

// Checkout
$('checkout').addEventListener('click', () => {
  if (!cart.size) return;
  cart.clear();
  renderCart();
  closeCart();
  showToast('🎉 Order placed! Your cloud kitchen feast is on its way.');
});

/* ============================================================
   INIT
   ============================================================ */
renderMenu();
renderCart();
</script>
</body>
</html>
